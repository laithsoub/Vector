{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vector",
  "version": "1.0.0",
  "identifier": "com.eaton.vector",
  "build": {
    "beforeDevCommand":   "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl":             "http://localhost:5173",
    "frontendDist":       "../dist"
  },
  "app": {
    "windows": [
      {
        "label":       "main",
        "title":       "Vector",
        "width":       1400,
        "height":      900,
        "minWidth":    1000,
        "minHeight":   600,
        "center":      true,
        "decorations": true,
        "visible":     false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png"
    }
  },
  "bundle": {
    "active":      true,
    "targets":     ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/server"],
    "resources": {
      "../ship-automation/":           "automation/",
      "../dist-server/sql-wasm.wasm":  "dist-server/sql-wasm.wasm",
      "../dist/":                      "dist/"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode":             "currentUser",
        "installerHooks":          "nsis-hooks.nsi"
      }
    },
    "publisher":          "Eaton",
    "copyright":          "2025 Eaton",
    "category":           "Business",
    "shortDescription":   "Eaton Quote & PMO Automation",
    "longDescription":    "Vector automates Eaton quote processing and PMO workflows."
  }
}
