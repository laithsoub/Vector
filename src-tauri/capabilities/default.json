{
  "$schema":    "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities",
  "windows":    ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "server", "sidecar": true }
      ]
    },
    "shell:allow-open",
    "window-state:default"
  ]
}
