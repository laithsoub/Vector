{
  "name": "vector",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "certs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/export-corporate-ca.ps1",
    "dev": "cross-env NODE_EXTRA_CA_CERTS=certs/corporate-roots.pem tsx server.ts",
    "dev:frontend": "vite",
    "dev:server": "cross-env TAURI_SIDECAR=1 NODE_EXTRA_CA_CERTS=certs/corporate-roots.pem tsx server.ts",
    "dev:tauri": "concurrently -n SERVER,TAURI -c blue,cyan \"npm run dev:server\" \"tauri dev\"",
    "build": "vite build",
    "build:frontend": "vite build",
    "build:server": "node build-server.mjs",
    "prepare:ship": "node prepare-ship.mjs",
    "build:tauri": "npm run build:server && npm run prepare:ship && tauri build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mantine/modals": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@mantine/spotlight": "^9.6.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@tauri-apps/plugin-window-state": "^2",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.13.6",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.511.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^15.0.0",
    "recharts": "^3.8.0",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0"
  },
  "overrides": {
    "shell-quote": "^1.8.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.9",
    "@yao-pkg/pkg": "^5.12.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.0.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "javascript-obfuscator": "^5.4.3",
    "postcss": "^8.5.3",
    "postject": "^1.0.0-alpha.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
